# Copy to .env (git-ignored). Values below are for the Docker Compose setup.
DATABASE_URL=postgresql+psycopg://vtu:vtu_dev_password@db:5432/vtu_ledger
JWT_SECRET=change-me-in-production
STORAGE_DIR=/srv/storage
MAX_UPLOAD_BYTES=10485760
# Browser origins allowed by CORS, comma-separated exact origins (no "*"). Default: the Vite dev server.
# Production: set the deployed frontend origin, e.g. CORS_ORIGINS=https://ledger.example.edu
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Minutes without progress before the Dean may mark a QUEUED/PROCESSING OCR batch FAILED (then retry it).
OCR_STALE_MINUTES=30
