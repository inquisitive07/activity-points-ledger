# Copy to .env.frontend (git-ignored) for the frontend integration API on port 8002 (docker-compose.frontend.yml).
# This environment is isolated: its own database (vtu_ledger_frontend), its own storage volume (storage_frontend)
# and its own JWT secret, so tokens from the main API (port 8001) are not accepted here. Never set vtu_ledger here.
DATABASE_URL=postgresql+psycopg://vtu:vtu_dev_password@db:5432/vtu_ledger_frontend
JWT_SECRET=replace-with-a-long-random-value-different-from-.env
STORAGE_DIR=/srv/storage
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OCR_STALE_MINUTES=30
